<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_car">
    <!-- 统一定义一次参数与材质 -->
    <xacro:include filename="common.xacro"/>
    <!-- 引入车身模块 -->
    <xacro:include filename="car/chassis.xacro"/>
    <!-- 引入车轮模块 -->
    <xacro:include filename="car/wheels.xacro"/>
    <!-- 引入雷达模块 -->
    <xacro:include filename="car/laser.xacro"/>
    <!-- 引入 IMU 模块 -->
    <xacro:include filename="car/imu.xacro"/>
    <!-- 引入 sonar 模块 -->
    <xacro:include filename="car/sonar.xacro"/>
    
    <!-- 调用宏实例化模型 -->
    <xacro:chassis_xacro/>
    <xacro:wheels_xacro/>
    <xacro:laser_xacro/> 
    <xacro:imu_xacro/> 
    <xacro:sonar_xacro/>

        <!-- ================= 1. 阿克曼专属驱动插件 ================= -->
    <gazebo>
        <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
            <ros>
                <namespace>/</namespace>
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>30.0</update_rate>

            <!-- 🔥 注意这里的参数名：必须写全，且与你 wheels.xacro 里的关节名绝对一致！ -->
            <left_steering_joint>left_front_steer_joint</left_steering_joint>
            <right_steering_joint>right_front_steer_joint</right_steering_joint>
            <left_rear_wheel_joint>left_rear_wheel_joint</left_rear_wheel_joint>
            <right_rear_wheel_joint>right_rear_wheel_joint</right_rear_wheel_joint>
            
            <!-- 几何尺寸 -->
            <wheelbase>0.112</wheelbase>
            <wheel_separation>0.164</wheel_separation>
            <wheel_radius>0.0245</wheel_radius>

            <!-- 核心：内置 PID 控制前轮，专治各种抽搐、抖动 -->
            <max_speed>1.5</max_speed>
            <max_steer>0.5</max_steer>
            <kp>100.0</kp>
            <kd>10.0</kd>
            
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
        </plugin>
    </gazebo>

    <!-- ================= 2. 关节状态发布插件 (必须加回来！) ================= -->
    <!-- 它的唯一任务是读取物理引擎的状态，发给 robot_state_publisher -->
    <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <update_rate>50</update_rate>
            <!-- 发布所有轮子和转向关节的状态 -->
            <joint_name>left_front_steer_joint</joint_name>
            <joint_name>right_front_steer_joint</joint_name>
            <joint_name>left_front_wheel_joint</joint_name>
            <joint_name>right_front_wheel_joint</joint_name>
            <joint_name>left_rear_wheel_joint</joint_name>
            <joint_name>right_rear_wheel_joint</joint_name>
        </plugin>
    </gazebo>
    
</robot>