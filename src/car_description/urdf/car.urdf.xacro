<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_car">
    <!-- 统一定义一次参数与材质 -->
    <xacro:include filename="common.xacro"/>
    <!-- 引入车身模块 -->
    <xacro:include filename="car/chassis.xacro"/>
    <!-- 引入车轮模块 -->
    <xacro:include filename="car/wheels.xacro"/>
    <!-- 引入雷达模块 -->
    <xacro:include filename="car/laser.xacro"/>
    <!-- 引入 IMU 模块 -->
    <xacro:include filename="car/imu.xacro"/>
    
    <!-- 调用宏实例化模型 -->
    <xacro:chassis_xacro/>
    <xacro:wheels_xacro/>
    <xacro:laser_xacro/> 
    <xacro:imu_xacro/> 

    <!-- ================= Gazebo 差速驱动插件 ================= -->
    <gazebo>
        <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
            <ros>
                <namespace>/</namespace>
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>50.0</update_rate>

            <!-- 使用后轮作为驱动轮（阿克曼的前轮只能被动跟随） -->
            <left_joint>left_rear_wheel_joint</left_joint>
            <right_joint>right_rear_wheel_joint</right_joint>

            <!-- 几何参数 -->
            <wheel_separation>0.164</wheel_separation>  <!-- 轮距 -->
            <wheel_diameter>0.049</wheel_diameter>      <!-- 车轮直径 -->

            <!-- 速度与扭矩限制 -->
            <max_wheel_torque>0.5</max_wheel_torque>
            <max_wheel_acceleration>2.0</max_wheel_acceleration>    <!-- 最大轮子加速度 -->

            <!-- 里程计与TF -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf> 
        </plugin>
    </gazebo>
     <!-- 让 Gazebo 专门发布前轮四个关节的 TF，这样 RViz 就能显示它们了 -->
    <gazebo>
        <plugin name="front_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <update_rate>50</update_rate>
            <joint_name>left_front_steer_joint</joint_name>
            <joint_name>right_front_steer_joint</joint_name>
            <joint_name>left_front_wheel_joint</joint_name>
            <joint_name>right_front_wheel_joint</joint_name>
            <joint_name>left_rear_wheel_joint</joint_name>
            <joint_name>right_rear_wheel_joint</joint_name>
        </plugin>
    </gazebo>
</robot>