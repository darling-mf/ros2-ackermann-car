<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="sonar_xacro">   
        <!-- ================= 超声波传感器 (模拟) ================= -->
    <link name="sonar_link">
        <visual>
            <geometry><sphere radius="0.01"/></geometry>
            <material name="black"/>
        </visual>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
    </link>
    <joint name="sonar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="sonar_link"/>
        <!-- 安装在车头正前方，高度与雷达相同 -->
        <origin xyz="0.12 0 0.05" rpy="0 0 0"/> 
    </joint>

    <gazebo reference="sonar_link">
        <sensor type="ray" name="sonar_sensor">
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples> <!-- 超声波只有一根射线 -->
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.02</min> <!-- 最小 2cm -->
                    <max>2.0</max>  <!-- 最大 2 米 -->
                </range>
            </ray>
            <plugin name="sonar_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <!-- 话题名为 /ultrasonic -->
                    <remapping>~/out:=ultrasonic</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>sonar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    </xacro:macro>
</robot>