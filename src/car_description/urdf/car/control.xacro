<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <!-- Gazebo 仿真硬件接口 -->
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        
        <!-- 前轮转向：位置控制 -->
        <joint name="left_front_steer_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_front_steer_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- 后轮驱动：速度控制 -->
        <joint name="left_rear_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_rear_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- 前轮滚动：只读取状态 -->
        <joint name="left_front_wheel_joint">
            <!--<command_interface name="position"/>-->
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="right_front_wheel_joint">
            <!--<command_interface name="position"/>-->
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!-- 加载 Gazebo 的 ros2_control 插件 -->
    <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
            <!-- 注意路径：这里指向你的 controllers.yaml -->
            <parameters>$(find car_bringup)/config/controllers.yaml</parameters>
            <ros>
                <!-- 重映射一些官方控制器的话题（控制器改名为 r5_steering_controller 后同步改） -->
                <remapping>/r5_steering_controller/tf_odometry:=/tf</remapping>
                <remapping>/r5_steering_controller/odometry:=/odom</remapping>
                <!-- controllers.yaml 中 use_stamped_vel 为 false 时控制器订阅
                     ~/reference_unstamped；这里把它映射成标准的 /cmd_vel -->
                <!-- 注意：URDF 注释里不要出现 ASCII 的“冒号+空格”，
                     gazebo_ros2_control 会把 robot_description 当作参数覆盖规则解析 -->
                <remapping>/r5_steering_controller/reference_unstamped:=/cmd_vel</remapping>
            </ros>
        </plugin>
    </gazebo>

    <!-- 地面真值通道（gazebo_ros_p3d）—— 一切量化验证的基准 -->
    <!-- ⚠️ 两个实测教训：
         1. 默认话题名是 odom（不是 ~/out），remap 必须写 odom:=xxx，
            否则它会跟控制器抢 /odom（同名话题双发布者，数据交叉污染）；
         2. frame_name 是“参考连杆名”，不填才是世界系——填 world 会被
            当作模型内连杆查找。 -->
    <gazebo>
        <plugin name="p3d_ground_truth" filename="libgazebo_ros_p3d.so">
            <update_rate>50.0</update_rate>
            <!-- 注意：base_link 与 base_footprint 是 fixed joint，被 Gazebo
                 固定关节合并（lumping）成一个连杆，幸存名是模型根 base_footprint。
                 用 gz model -m ackermann_car -i 可查实际连杆名。 -->
            <body_name>base_footprint</body_name>
            <gaussian_noise>0.0</gaussian_noise>
            <ros>
                <remapping>odom:=ground_truth</remapping>
            </ros>
        </plugin>
    </gazebo>
</robot>