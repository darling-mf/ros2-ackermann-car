<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="wheels_xacro" >
    <!-- ================= 1. 后轮驱动系统（后轮转向和滚动） ================= -->
    <!--prefix:部件名字前缀，y_reflect:左右镜像标志，1表示左轮，-1表示右轮-->

    <xacro:macro name="rear_wheel" params="prefix y_reflect">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <!-- 惯性矩阵 -->
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
        </link>

        <!-- 后轮驱动关节（连续旋转）(加入 dynamics) -->
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <!-- 后轮位置：轴距的一半（负X轴），轮距的一半（Y轴镜像） -->
            <!-- rpy=+90° 后，关节局部 +z 指向世界 -y；取 -z 才能让
                 “正速度 = 车向前 (+x)” 与控制器/里程计符号一致 -->
            <origin xyz="${-wheelbase/2} ${y_reflect * track/2} 0" rpy="1.5707 0 0"/>
            <axis xyz="0 0 -1"/>
            <limit effort="10.0" velocity="45.0"/>
        </joint>
    </xacro:macro>
    <!--左右后轮-->
    <xacro:rear_wheel prefix="left_rear" y_reflect="1"/>
    <xacro:rear_wheel prefix="right_rear" y_reflect="-1"/>

    <!-- ================= 2. 前轮转向系统（阿克曼转向） ================= -->
    <xacro:macro name="front_steering_wheel" params="prefix y_reflect">
        <!-- 转向节（作为转向电机和车轮的中间连接件） -->
        <link name="${prefix}_steer_link">
            <visual>
                <geometry><cylinder radius="0.01" length="0.02"/></geometry>
                <material name="red"/>
            </visual>
            <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
        </link>

        <!-- 转向关节（绕Z轴旋转，对应舵机） -->
        <joint name="${prefix}_steer_joint" type="revolute">
            <parent link="base_link"/>
            <child link="${prefix}_steer_link"/>
            <!-- 前轮位置：轴距的一半（正X轴） -->
            <origin xyz="${wheelbase/2} ${y_reflect * track/2} 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <!-- 加入阻尼和摩擦，防止转向轮自发抖动 -->
            <dynamics damping="2.0" friction="0.5"/> 

            <!-- 实车依据（手册参数表）：最小转弯半径 0.55m → 内侧前轮
                 atan(0.112/(0.55-0.082)) ≈ 0.235 rad（外侧 0.176 rad）；
                 舵机 S620F-180 响应 0.11s/60° ≈ 9.5 rad/s -->
            <limit effort="10" lower="-0.235" upper="0.235" velocity="9.5"/>
        </joint>

        <!-- 前轮轮子 -->
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
        </link>

        <!-- 前轮滚动关节（连续旋转） -->
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${prefix}_steer_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <axis xyz="0 0 -1"/>
            <limit effort="10.0" velocity="45.0"/>
        </joint>
    </xacro:macro>

    <xacro:front_steering_wheel prefix="left_front" y_reflect="1"/>
    <xacro:front_steering_wheel prefix="right_front" y_reflect="-1"/>

        <!-- Gazebo 专属标签：设置四个轮子的颜色和摩擦力 -->
    <gazebo reference="left_rear_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>  <!-- 滚动方向摩擦系数 -->
        <mu2>1.0</mu2>  <!-- 侧滑方向摩擦系数 -->
    </gazebo>
    <gazebo reference="right_rear_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <!-- 阿克曼车的四个轮子都需要足够的侧向抓地力（mu2），
         前轮 mu2=0.1 会让车头侧滑、无法按转角转弯 -->
    <gazebo reference="left_front_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_front_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    </xacro:macro>
</robot>