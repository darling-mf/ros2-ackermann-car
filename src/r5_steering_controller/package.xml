<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r5_steering_controller</name>
  <version>0.1.0</version>
  <description>
    TARKBOT R5 阿克曼控制器。基于 ackermann_steering_controller 扩展了两个
    实车约束：加速度限幅（保护 AT8236 驱动和电流预算）和速度相关转向限幅
    （限制侧向加速度，避免高速侧滑）。
  </description>
  <maintainer email="darling@ros.com">mjf</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 直接继承 ackermann 控制器：只叠加行为，不复制运动学代码 -->
  <depend>ackermann_steering_controller</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
