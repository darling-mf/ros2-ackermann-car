; 仅主机测试环境（无需硬件）：pio run -e native_test
[env:native_test]
platform = native
build_flags = -std=c99 -Wall -Wextra -I src
test_filter = test_host
src_dir = src
test_dir = test

; 固件目标示例（需按厂家 SPL/FreeRTOS/链接脚本调整，未验证）
